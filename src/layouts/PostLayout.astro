---
import BaseLayout from './BaseLayout.astro';
import type { CollectionEntry } from 'astro:content';

interface Props {
  post: CollectionEntry<'blog'>;
}

const { post } = Astro.props;
const { title, description, pubDate, updatedDate, heroImage, tags, category } = post.data;

const formattedPubDate = pubDate.toLocaleDateString('pt-BR', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});

const formattedUpdatedDate = updatedDate?.toLocaleDateString('pt-BR', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});

const categoryColors: Record<string, string> = {
  tutorial: 'badge--primary',
  plugin: 'badge--purple',
  moodle: 'badge--accent',
  ia: 'badge--secondary',
  gamificacao: 'badge--secondary',
  geral: 'badge--muted',
};
---

<BaseLayout title={`${title} — Jean Lúcio`} description={description} image={heroImage}>
  <article class="post-page">
    {heroImage && (
      <div class="post-hero-image">
        <img src={heroImage} alt={title} />
      </div>
    )}

    <div class="container--narrow">
      <header class="post-header">
        <div class="post-meta">
          {category && (
            <span class={`badge ${categoryColors[category] ?? 'badge--muted'}`}>
              {category}
            </span>
          )}
          <time datetime={pubDate.toISOString()}>{formattedPubDate}</time>
          {updatedDate && (
            <span class="post-updated">· Atualizado em {formattedUpdatedDate}</span>
          )}
        </div>

        <h1 class="post-title">{title}</h1>
        <p class="post-description">{description}</p>

        {tags.length > 0 && (
          <div class="post-tags">
            {tags.map(tag => (
              <span class="badge badge--muted">#{tag}</span>
            ))}
          </div>
        )}
      </header>

      <div class="prose">
        <slot />
      </div>

      <footer class="post-footer">
        <a href="/blog" class="btn btn--outline">← Voltar ao blog</a>
      </footer>
    </div>
  </article>
</BaseLayout>

<style>
  .post-page {
    padding-bottom: 5rem;
  }

  .post-hero-image {
    width: 100%;
    max-height: 420px;
    overflow: hidden;
    margin-bottom: 2.5rem;
  }

  .post-hero-image img {
    width: 100%;
    height: 420px;
    object-fit: cover;
  }

  .post-header {
    padding-top: 2.5rem;
    margin-bottom: 2.5rem;
    padding-bottom: 2rem;
    border-bottom: 2px solid var(--color-border);
  }

  .post-meta {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    flex-wrap: wrap;
    margin-bottom: 1rem;
    color: var(--color-text-muted);
    font-size: 0.9rem;
  }

  .post-title {
    font-size: clamp(1.75rem, 4vw, 2.5rem);
    font-weight: 800;
    line-height: 1.2;
    margin-bottom: 1rem;
  }

  .post-description {
    font-size: 1.15rem;
    color: var(--color-text-muted);
    line-height: 1.6;
    margin-bottom: 1rem;
  }

  .post-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  .post-footer {
    margin-top: 3rem;
    padding-top: 2rem;
    border-top: 2px solid var(--color-border);
  }
</style>
