---
import BaseLayout from './BaseLayout.astro';
import type { CollectionEntry } from 'astro:content';

interface Props {
  post: CollectionEntry<'blog'>;
}

const { post } = Astro.props;
const { title, description, pubDate, updatedDate, heroImage, tags, category } = post.data;

const pageUrl = encodeURIComponent(Astro.url.href);
const pageTitle = encodeURIComponent(title);

const pageDescription = encodeURIComponent(description ?? '');

const shareLinks = {
  linkedin: `https://www.linkedin.com/shareArticle?mini=true&url=${pageUrl}&title=${pageTitle}&summary=${pageDescription}&source=jeanlucio.github.io`,
  facebook: `https://www.facebook.com/sharer/sharer.php?u=${pageUrl}`,
  twitter: `https://twitter.com/intent/tweet?url=${pageUrl}&text=${pageTitle}`,
  whatsapp: `https://wa.me/?text=${pageTitle}%20${pageUrl}`,
  bluesky: `https://bsky.app/intent/compose?text=${pageTitle}%20${pageUrl}`,
  telegram: `https://t.me/share/url?url=${pageUrl}&text=${pageTitle}`,
};

const formattedPubDate = pubDate.toLocaleDateString('pt-BR', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});

const formattedUpdatedDate = updatedDate?.toLocaleDateString('pt-BR', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});

const categoryColors: Record<string, string> = {
  tutorial: 'badge--primary',
  plugin: 'badge--purple',
  moodle: 'badge--accent',
  ia: 'badge--secondary',
  gamificacao: 'badge--secondary',
  geral: 'badge--muted',
};
---

<BaseLayout title={`${title} — Jean Lúcio`} description={description} image={heroImage}>
  <article class="post-page">
    {heroImage && (
      <div class="post-hero-image">
        <img src={heroImage} alt={title} />
      </div>
    )}

    <div class="container--narrow">
      <header class="post-header">
        <div class="post-meta">
          {category && (
            <span class={`badge ${categoryColors[category] ?? 'badge--muted'}`}>
              {category}
            </span>
          )}
          <span class="post-author">Jean Lúcio Santos Evangelista</span>
          <span class="post-meta-sep" aria-hidden="true">·</span>
          <time datetime={pubDate.toISOString()}>{formattedPubDate}</time>
          {updatedDate && (
            <span class="post-updated">· Atualizado em {formattedUpdatedDate}</span>
          )}
          <span class="post-meta-sep" aria-hidden="true">·</span>
          <span class="post-views">
            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7z"/><circle cx="12" cy="12" r="3"/></svg>
            <span class="post-views-count" data-path={Astro.url.pathname} aria-label="Visualizações desta página"></span>
          </span>
        </div>

        <h1 class="post-title">{title}</h1>
        <p class="post-description">{description}</p>

        {tags.length > 0 && (
          <div class="post-tags">
            {tags.map(tag => (
              <span class="badge badge--muted">#{tag}</span>
            ))}
          </div>
        )}
      </header>

      <div class="prose">
        <slot />
      </div>

      <div class="post-share">
        <p class="post-share-label">Compartilhar</p>
        <div class="post-share-buttons">
          <a href={shareLinks.linkedin} target="_blank" rel="noopener noreferrer" class="share-btn share-btn--linkedin" aria-label="Compartilhar no LinkedIn">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 0 1-2.063-2.065 2.064 2.064 0 1 1 2.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
            </svg>
          </a>
          <a href={shareLinks.facebook} target="_blank" rel="noopener noreferrer" class="share-btn share-btn--facebook" aria-label="Compartilhar no Facebook">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
            </svg>
          </a>
          <a href={shareLinks.twitter} target="_blank" rel="noopener noreferrer" class="share-btn share-btn--twitter" aria-label="Compartilhar no X (Twitter)">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
            </svg>
          </a>
          <a href={shareLinks.whatsapp} target="_blank" rel="noopener noreferrer" class="share-btn share-btn--whatsapp" aria-label="Compartilhar no WhatsApp">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413z"/>
            </svg>
          </a>
          <a href={shareLinks.bluesky} target="_blank" rel="noopener noreferrer" class="share-btn share-btn--bluesky" aria-label="Compartilhar no Bluesky">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 600 530" fill="currentColor" aria-hidden="true">
              <path d="M300 110c-60-80-180-100-240-60-60 40-70 130-20 190 40 50 240 240 260 270 20-30 220-220 260-270 50-60 40-150-20-190-60-40-180-20-240 60z"/>
            </svg>
          </a>
          <a href={shareLinks.telegram} target="_blank" rel="noopener noreferrer" class="share-btn share-btn--telegram" aria-label="Compartilhar no Telegram">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M11.944 0A12 12 0 0 0 0 12a12 12 0 0 0 12 12 12 12 0 0 0 12-12A12 12 0 0 0 12 0a12 12 0 0 0-.056 0zm4.962 7.224c.1-.002.321.023.465.14a.506.506 0 0 1 .171.325c.016.093.036.306.02.472-.18 1.898-.962 6.502-1.36 8.627-.168.9-.499 1.201-.82 1.23-.696.065-1.225-.46-1.9-.902-1.056-.693-1.653-1.124-2.678-1.8-1.185-.78-.417-1.21.258-1.91.177-.184 3.247-2.977 3.307-3.23.007-.032.014-.15-.056-.212s-.174-.041-.249-.024c-.106.024-1.793 1.14-5.061 3.345-.48.33-.913.49-1.302.48-.428-.008-1.252-.241-1.865-.44-.752-.245-1.349-.374-1.297-.789.027-.216.325-.437.893-.663 3.498-1.524 5.83-2.529 6.998-3.014 3.332-1.386 4.025-1.627 4.476-1.635z"/>
            </svg>
          </a>
        </div>
      </div>

      <div class="post-comments">
        <div id="remark42"></div>
        <script is:inline>
          var remark_config = {
            host: 'https://jeanlucio-comments.duckdns.org',
            site_id: 'jeanlucio-github-io',
            locale: 'pt-BR',
            theme: 'light',
          };
          (function(c) {
            for (var i = 0; i < c.length; i++) {
              var d = document, s = d.createElement('script');
              s.src = remark_config.host + '/web/' + c[i] + '.js';
              s.defer = true;
              (d.head || d.body).appendChild(s);
            }
          })(remark_config.components || ['embed']);
        </script>
      </div>

      <footer class="post-footer">
        <a href="/blog" class="btn btn--outline">← Voltar ao blog</a>
      </footer>
    </div>
  </article>
</BaseLayout>

<style>
  .post-page {
    padding-bottom: 5rem;
  }

  .post-hero-image {
    width: 100%;
    max-height: 420px;
    overflow: hidden;
    margin-bottom: 2.5rem;
  }

  .post-hero-image img {
    width: 100%;
    height: 420px;
    object-fit: cover;
  }

  .post-header {
    padding-top: 2.5rem;
    margin-bottom: 2.5rem;
    padding-bottom: 2rem;
    border-bottom: 2px solid var(--color-border);
  }

  .post-meta {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    flex-wrap: wrap;
    margin-bottom: 1rem;
    color: var(--color-text-muted);
    font-size: 0.9rem;
  }

  .post-author {
    font-weight: 600;
    color: var(--color-text);
  }

  .post-meta-sep {
    color: var(--color-border);
  }

  .post-title {
    font-size: clamp(1.75rem, 4vw, 2.5rem);
    font-weight: 800;
    line-height: 1.2;
    margin-bottom: 1rem;
  }

  .post-description {
    font-size: 1.15rem;
    color: var(--color-text-muted);
    line-height: 1.6;
    margin-bottom: 1rem;
  }

  .post-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  .post-share {
    margin-top: 3rem;
    padding-top: 2rem;
    border-top: 2px solid var(--color-border);
  }

  .post-share-label {
    font-size: 0.8rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-text-muted);
    margin-bottom: 0.75rem;
  }

  .post-share-buttons {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .share-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: var(--radius-sm);
    color: #fff;
    text-decoration: none;
    transition: opacity 0.2s ease, transform 0.2s ease;
  }

  .share-btn:hover {
    opacity: 0.85;
    transform: translateY(-1px);
    color: #fff;
  }

  .share-btn--linkedin  { background: #0A66C2; }
  .share-btn--facebook  { background: #1877F2; }
  .share-btn--twitter   { background: #000; }
  .share-btn--whatsapp  { background: #25D366; }
  .share-btn--bluesky   { background: #0085FF; }
  .share-btn--telegram  { background: #229ED9; }

  .post-comments {
    margin-top: 3rem;
    padding-top: 2rem;
    border-top: 2px solid var(--color-border);
  }

  .post-footer {
    margin-top: 1.5rem;
  }

  .post-views {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
  }
</style>

<script>
  const el = document.querySelector<HTMLElement>('.post-views-count');
  if (el) {
    const path = el.dataset.path ?? '';
    try {
      const res = await fetch(`https://jeanlucio.goatcounter.com/counter${path}.json`, { cache: 'no-store' });
      const data = await res.json() as { count: string };
      el.textContent = data.count;
    } catch {
      el.remove();
    }
  }
</script>
