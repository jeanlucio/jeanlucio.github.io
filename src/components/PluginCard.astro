---
interface Props {
  name: string;
  description: string;
  version: string;
  tags: string[];
  githubUrl: string;
  moodleUrl?: string;
  docsUrl?: string;
  color?: 'indigo' | 'purple' | 'emerald' | 'amber';
  icon?: string;
}

const {
  name,
  description,
  version,
  tags,
  githubUrl,
  moodleUrl,
  docsUrl,
  color = 'indigo',
  icon = '🔌',
} = Astro.props;
---

<article class={`plugin-card plugin-card--${color}`}>
  <div class="plugin-card-top">
    <div class="plugin-icon" aria-hidden="true">{icon}</div>
    <div class="plugin-version">
      <span class="badge badge--muted">v{version}</span>
    </div>
  </div>

  <h3 class="plugin-name">{name}</h3>
  <p class="plugin-description">{description}</p>

  <div class="plugin-tags">
    {tags.map(tag => (
      <span class="badge badge--muted">{tag}</span>
    ))}
  </div>

  <div class="plugin-links">
    <a href={githubUrl} class="btn btn--outline btn--sm" target="_blank" rel="noopener noreferrer">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
        <path d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0 1 12 6.844a9.59 9.59 0 0 1 2.504.337c1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.02 10.02 0 0 0 22 12.017C22 6.484 17.522 2 12 2z" />
      </svg>
      GitHub
    </a>

    {moodleUrl && (
      <a href={moodleUrl} class="btn btn--primary btn--sm" target="_blank" rel="noopener noreferrer">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 6H5.25A2.25 2.25 0 0 0 3 8.25v10.5A2.25 2.25 0 0 0 5.25 21h10.5A2.25 2.25 0 0 0 18 18.75V10.5m-10.5 6L21 3m0 0h-5.25M21 3v5.25" />
        </svg>
        Moodle.org
      </a>
    )}

    {docsUrl && (
      <a href={docsUrl} class="btn btn--outline btn--sm">
        Docs
      </a>
    )}
  </div>
</article>

<style>
  .plugin-card {
    background: var(--color-bg-card);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: 1.75rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    transition: box-shadow 0.2s ease, transform 0.2s ease;
    position: relative;
    overflow: hidden;
  }

  .plugin-card::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 4px;
    border-radius: var(--radius-lg) var(--radius-lg) 0 0;
  }

  .plugin-card--indigo::before { background: linear-gradient(90deg, #4F46E5, #818CF8); }
  .plugin-card--purple::before { background: linear-gradient(90deg, #7C3AED, #A78BFA); }
  .plugin-card--emerald::before { background: linear-gradient(90deg, #10B981, #6EE7B7); }
  .plugin-card--amber::before { background: linear-gradient(90deg, #F59E0B, #FCD34D); }

  .plugin-card:hover {
    box-shadow: var(--shadow-lg);
    transform: translateY(-3px);
  }

  .plugin-card-top {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
  }

  .plugin-icon {
    font-size: 2.25rem;
    line-height: 1;
  }

  .plugin-name {
    font-size: 1.2rem;
    font-weight: 700;
    margin: 0;
  }

  .plugin-description {
    color: var(--color-text-muted);
    font-size: 0.925rem;
    line-height: 1.6;
    flex: 1;
    margin: 0;
  }

  .plugin-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
  }

  .plugin-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 0.25rem;
  }
</style>
