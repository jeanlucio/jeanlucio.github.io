---
import BaseLayout from '../layouts/BaseLayout.astro';
import PluginCard from '../components/PluginCard.astro';
import { playerGames, teacherTools, webTools } from '../data/plugins';
---

<BaseLayout
  title="Projetos — Jean Lúcio"
  description="Plugins open source para Moodle e ferramentas web para educação."
>
  <section class="projects-page">
    <div class="container">
      <header class="page-header">
        <h1 class="page-title">Projetos</h1>
        <p class="page-subtitle">
          Plugins open source para Moodle e ferramentas web para educação.
          Tudo licenciado sob <strong>GPL v3+</strong>.
        </p>
      </header>

      <!-- Plugins Moodle -->
      <div class="section-label">
        <span class="section-platform">Plugins Moodle</span>
      </div>

      <section class="plugin-group">
        <header class="group-header">
          <div class="group-header-top">
            <div class="group-label">
              <span class="group-icon" aria-hidden="true">🕹️</span>
              <h2 class="group-title">Ecossistema PlayerGames</h2>
            </div>
            <a
              href="https://jeanlucio.github.io/en/playergames/"
              class="btn btn--outline btn--sm"
              target="_blank"
              rel="noopener noreferrer"
            >
              Ver ecossistema →
            </a>
          </div>
          <p class="group-description">
            Conjunto de plugins complementares que trazem gamificação de ponta a ponta para o Moodle.
            Cada plugin funciona de forma independente e em conjunto.
          </p>
        </header>

        <div class="plugins-grid">
          {playerGames.map(plugin => (
            <PluginCard {...plugin} />
          ))}
        </div>
      </section>

      <section class="plugin-group">
        <header class="group-header">
          <div class="group-label">
            <span class="group-icon" aria-hidden="true">🧑‍🏫</span>
            <h2 class="group-title">Ferramentas para Professores</h2>
          </div>
          <p class="group-description">
            Plugins independentes focados em qualidade de curso e análise de engajamento.
          </p>
        </header>

        <div class="plugins-grid">
          {teacherTools.map(plugin => (
            <PluginCard {...plugin} />
          ))}
        </div>
      </section>

      <!-- Ferramentas Web -->
      <div class="section-label section-label--web">
        <span class="section-platform">Ferramentas Web</span>
      </div>

      <section class="plugin-group">
        <header class="group-header">
          <div class="group-label">
            <span class="group-icon" aria-hidden="true">🌐</span>
            <h2 class="group-title">Aplicações independentes</h2>
          </div>
          <p class="group-description">
            Ferramentas que rodam no navegador, sem necessidade de instalar no Moodle.
          </p>
        </header>

        <div class="plugins-grid">
          {webTools.map(tool => (
            <PluginCard {...tool} />
          ))}
        </div>
      </section>

      <aside class="footer-note">
        <a
          href="https://github.com/jeanlucio"
          class="btn btn--outline"
          target="_blank"
          rel="noopener noreferrer"
        >
          Ver todos no GitHub →
        </a>
      </aside>
    </div>
  </section>
</BaseLayout>

<style>
  .projects-page {
    padding: 4rem 0 6rem;
  }

  .page-header {
    margin-bottom: 3.5rem;
    max-width: 640px;
  }

  .page-title {
    font-size: clamp(2rem, 5vw, 3rem);
    font-weight: 800;
    margin-bottom: 0.5rem;
  }

  .page-subtitle {
    color: var(--color-text-muted);
    font-size: 1.1rem;
    line-height: 1.6;
  }

  .section-label {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 2rem;
  }

  .section-label--web {
    margin-top: 1rem;
  }

  .section-platform {
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-text-muted);
    background: var(--color-bg-alt);
    padding: 0.3rem 0.85rem;
    border-radius: 999px;
    border: 1px solid var(--color-border);
  }

  .section-label::after {
    content: '';
    flex: 1;
    height: 1px;
    background: var(--color-border);
  }

  .plugin-group {
    margin-bottom: 3rem;
  }

  .group-header {
    margin-bottom: 1.75rem;
    padding-bottom: 1.25rem;
    border-bottom: 2px solid var(--color-border);
  }

  .group-header-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-bottom: 0.5rem;
  }

  .group-label {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    margin-bottom: 0.5rem;
  }

  .group-icon {
    font-size: 1.4rem;
  }

  .group-title {
    font-size: 1.3rem;
    font-weight: 700;
  }

  .group-description {
    color: var(--color-text-muted);
    font-size: 0.95rem;
    line-height: 1.6;
    margin: 0;
    max-width: 640px;
  }

  .plugins-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(290px, 1fr));
    gap: 1.25rem;
  }

  .footer-note {
    margin-top: 1rem;
    text-align: center;
  }
</style>
