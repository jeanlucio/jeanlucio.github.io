---
import BaseLayout from '../layouts/BaseLayout.astro';
import PluginCard from '../components/PluginCard.astro';
import { playerGames, ecosystemLastUpdated } from '../data/plugins';

// Compute ecosystem last-updated date
const _rawTs = ecosystemLastUpdated
  ? new Date(ecosystemLastUpdated).getTime()
  : Math.max(...playerGames.filter(p => p.updatedDate).map(p => new Date(p.updatedDate!).getTime()));
const _rawDate = new Date(_rawTs);
const lastUpdatedEN = `Last updated: ${_rawDate.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}`;
const lastUpdatedPT = `Última atualização: ${_rawDate.toLocaleDateString('pt-BR', { year: 'numeric', month: 'long', day: 'numeric' })}`;


// English descriptions and tags — version/updatedDate come from plugins.ts (kept in sync by update-versions.mjs)
const enOverrides: Record<string, { description: string; tags: string[]; docsUrl?: string }> = {
  'PlayerHUD': {
    description: 'The core gamification block for Moodle. Brings XP, customizable levels, achievements, ranking, missions, activity history, and an integrated AI assistant to your courses. Teachers define the rules — students choose to engage.',
    tags: ['Block', 'Gamification', 'XP', 'Achievements', 'AI', 'Ranking'],
    docsUrl: 'https://jeanlucio.github.io/moodle-block_playerhud/',
  },
  'PlayerHUD Filter': {
    description: 'A companion text filter that lets you embed live PlayerHUD data — current level, XP, and progress — directly inside Moodle activity content using simple shortcodes. No need to leave the page.',
    tags: ['Filter', 'Gamification', 'Dynamic Content', 'Shortcodes'],
    docsUrl: 'https://jeanlucio.github.io/moodle-filter_playerhud/',
  },
  'PlayerHUD Availability': {
    description: "An availability condition that restricts access to activities, resources, or course sections based on a student's PlayerHUD progress — unlock content only when a student reaches a specific level or XP threshold.",
    tags: ['Availability', 'Gamification', 'XP Gating', 'Conditional Access'],
  },
  'PlayerGroup': {
    description: 'Lets students autonomously form their own groups directly from the activity page — no teacher intervention needed. Replaces manual group assignment with a self-service experience that works with any course format.',
    tags: ['Activity', 'Groups', 'Collaboration', 'Gamification'],
  },
};

const plugins = playerGames.map(({ reviewUrl: _r, ...p }) => ({
  ...p,
  ...(enOverrides[p.name] ?? {}),
}));

// Plugins in development or review — no Moodle URL yet, version omitted
const inDev = [
  {
    name: 'PlayerGames',
    description: 'The central hub of the ecosystem. Manages cartridges, quizzes, leaderboards and a full suite of gamified mini-games — providing a unified engine that all Player* activities connect to.',
    status: 'In development · 75%',
    tags: ['Local', 'Hub', 'Gamification', 'AI', 'Quizzes'],
    githubUrl: 'https://github.com/jeanlucio/moodle-local_playergames',
    docsUrl: 'https://jeanlucio.github.io/moodle-local_playergames/',
    color: 'indigo' as const,
    icon: '🎮',
  },
  {
    name: 'PlayerGames Block',
    description: 'A lightweight block that mirrors the PlayerHUD profile panel on the dashboard and homepage — showing XP, level and missions without requiring a full block re-render.',
    status: 'In review',
    tags: ['Block', 'Dashboard', 'Gamification'],
    githubUrl: 'https://github.com/jeanlucio/moodle-block_playergames',
    color: 'indigo' as const,
    icon: '📊',
  },
  {
    name: 'PlayerCross',
    description: 'A crossword-puzzle activity powered by course content. Clues are generated from the glossary or via AI, and students solve the mystery phrase by filling in the grid.',
    status: 'In development · 80%',
    tags: ['Activity', 'Crossword', 'AI', 'Vocabulary'],
    githubUrl: 'https://github.com/jeanlucio/moodle-mod_playercross',
    color: 'purple' as const,
    icon: '🔤',
  },
  {
    name: 'PlayerLand',
    description: 'A 2-D side-scroller game (Phaser) where students run through a course-themed level and answer formative questions embedded as in-world blocks.',
    status: 'In development · 65%',
    tags: ['Activity', 'Game', 'Phaser', 'Formative'],
    githubUrl: 'https://github.com/jeanlucio/moodle-mod_playerland',
    color: 'purple' as const,
    icon: '🦊',
  },
  {
    name: 'PlayerPuzzle',
    description: 'A Match-3 puzzle activity where correct answers clear tiles. Progress, scoring and debrief integrate with the gradebook and the PlayerHUD XP system.',
    status: 'In development · 28%',
    tags: ['Activity', 'Match-3', 'Game', 'AI'],
    githubUrl: 'https://github.com/jeanlucio/moodle-mod_playerpuzzle',
    color: 'indigo' as const,
    icon: '🧩',
  },
  {
    name: 'PlayerRaid',
    description: 'A cooperative raid activity where student teams tackle challenge waves together. XP rewards and team rankings feed directly into PlayerHUD.',
    status: 'In development · 20%',
    tags: ['Activity', 'Cooperative', 'Teams', 'Gamification'],
    githubUrl: 'https://github.com/jeanlucio/moodle-mod_playerraid',
    color: 'purple' as const,
    icon: '⚔️',
  },
  {
    name: 'PlayerWords',
    description: 'A word-game activity (Wordle-style) that challenges students to guess vocabulary terms from the course. Supports AI-generated clues and connects to PlayerHUD XP.',
    status: 'In review',
    tags: ['Activity', 'Vocabulary', 'Word Game', 'AI'],
    githubUrl: 'https://github.com/jeanlucio/moodle-mod_playerwords',
    docsUrl: 'https://jeanlucio.github.io/moodle-mod_playerwords/',
    color: 'indigo' as const,
    icon: '🔠',
  },
];
---

<BaseLayout
  title="PlayerGames — Gamification Ecosystem for Moodle"
  description="PlayerGames is an open source ecosystem of Moodle plugins built around gamification and student engagement. Developed by Jean Lúcio."
>
  <section class="pg-page">
    <div class="container">

      <!-- Hero -->
      <header class="pg-hero">
        <div class="pg-hero-badge">🕹️ Open Source · GPL v3+</div>
        <h1 class="pg-hero-title">
          <span class="pg-hero-ecosystem">Ecosystem</span>
          PlayerGames
        </h1>

        <!-- Language switcher -->
        <div class="pg-lang-switcher">
          <button class="pg-lang-btn active" data-lang="en" id="btn-lang-en">English</button>
          <span class="pg-lang-sep">|</span>
          <button class="pg-lang-btn" data-lang="pt" id="btn-lang-pt">Português</button>
        </div>

        <p class="pg-hero-origin" data-i18n="origin"></p>
        <p class="pg-hero-subtitle" data-i18n="subtitle"></p>
        <a
          href="https://github.com/jeanlucio"
          class="btn btn--outline"
          target="_blank"
          rel="noopener noreferrer"
          data-i18n="viewGithub"
        ></a>
        <p class="pg-last-updated"
          data-updated-en={lastUpdatedEN}
          data-updated-pt={lastUpdatedPT}
        >{lastUpdatedEN}</p>
      </header>

      <!-- Published Plugins -->
      <div class="pg-section-label">
        <span class="pg-section-tag" data-i18n="labelPublished"></span>
      </div>

      <div class="pg-grid">
        {plugins.map(plugin => (
          <div data-plugin-key={plugin.name}>
            <PluginCard {...plugin} />
          </div>
        ))}
      </div>

      <!-- In Development & Review -->
      <div class="pg-section-label pg-section-label--dev">
        <span class="pg-section-tag pg-section-tag--dev" data-i18n="labelInDev"></span>
      </div>

      <div class="pg-grid">
        {inDev.map(plugin => (
          <div class="pg-dev-card-wrapper" data-plugin-key={plugin.name}>
            <span class="pg-dev-status" data-i18n-status={plugin.status}></span>
            <PluginCard {...plugin} />
          </div>
        ))}
      </div>

      <!-- Suggestions -->
      <div class="pg-suggestions">
        <h2 class="pg-suggestions-title" data-i18n="suggestionsTitle"></h2>
        <p class="pg-suggestions-text" data-i18n="suggestionsText"></p>
        <a
          href="https://github.com/jeanlucio"
          class="btn btn--primary"
          target="_blank"
          rel="noopener noreferrer"
          data-i18n="suggestionsBtn"
        ></a>
      </div>

    </div>
  </section>
</BaseLayout>

<style>
  .pg-page {
    padding: 4rem 0 6rem;
  }

  /* Hero */
  .pg-hero {
    text-align: center;
    margin: 0 auto 4rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.25rem;
  }

  .pg-hero-badge {
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-text-muted);
    background: var(--color-bg-alt);
    border: 1px solid var(--color-border);
    padding: 0.3rem 0.9rem;
    border-radius: 999px;
  }

  .pg-hero-title {
    font-size: clamp(2.5rem, 6vw, 3.75rem);
    font-weight: 800;
    margin: 0;
    line-height: 1.1;
  }

  .pg-hero-ecosystem {
    display: block;
    font-size: clamp(0.85rem, 1.5vw, 1rem);
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-primary, #4F46E5);
    opacity: 0.75;
    margin-bottom: 0.2rem;
  }

  .pg-hero-subtitle {
    font-size: 1.15rem;
    color: var(--color-text-muted);
    line-height: 1.7;
    margin: 0;
  }

  .pg-hero-origin {
    font-size: 1.05rem;
    color: var(--color-text-muted);
    line-height: 1.75;
    margin: 0;
    font-style: italic;
  }

  .pg-last-updated {
    font-size: 0.8rem;
    color: var(--color-text-muted);
    margin: 0;
    opacity: 0.7;
  }

  /* Language switcher */
  .pg-lang-switcher {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .pg-lang-btn {
    background: none;
    border: none;
    cursor: pointer;
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--color-text-muted);
    padding: 0;
    transition: color 0.15s;
  }

  .pg-lang-btn:hover {
    color: var(--color-primary);
  }

  .pg-lang-btn.active {
    color: var(--color-primary);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .pg-lang-sep {
    color: var(--color-border);
    user-select: none;
  }

  /* Section label */
  .pg-section-label {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 2rem;
  }

  .pg-section-label::after {
    content: '';
    flex: 1;
    height: 1px;
    background: var(--color-border);
  }

  .pg-section-tag {
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-text-muted);
    background: var(--color-bg-alt);
    padding: 0.3rem 0.85rem;
    border-radius: 999px;
    border: 1px solid var(--color-border);
    white-space: nowrap;
  }

  /* Grid */
  .pg-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(290px, 1fr));
    gap: 1.25rem;
    margin-bottom: 4rem;
  }

  /* In development & review section */
  .pg-section-label--dev {
    margin-top: 0;
  }

  .pg-section-tag--dev {
    color: #B45309;
    background: rgba(245, 158, 11, 0.08);
    border-color: rgba(245, 158, 11, 0.3);
  }

  /* Dev card wrapper — positions the status badge on top of the PluginCard */
  .pg-dev-card-wrapper {
    position: relative;
    display: flex;
    flex-direction: column;
  }

  .pg-dev-status {
    display: inline-block;
    align-self: flex-end;
    margin-bottom: 0.4rem;
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    padding: 0.2rem 0.6rem;
    border-radius: 999px;
    background: rgba(245, 158, 11, 0.12);
    color: #B45309;
    border: 1px solid rgba(245, 158, 11, 0.3);
    white-space: nowrap;
  }

  /* Suggestions */
  .pg-suggestions {
    text-align: center;
    max-width: 560px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
  }

  .pg-suggestions-title {
    font-size: 1.5rem;
    font-weight: 700;
    margin: 0;
  }

  .pg-suggestions-text {
    color: var(--color-text-muted);
    font-size: 0.975rem;
    line-height: 1.7;
    margin: 0;
  }
</style>

<script>
(function () {
  const T = {
    en: {
      origin: 'I have always been passionate about games — and for years I have been exploring ways to bring them into education through Moodle. After working extensively with gamification and game-based learning, I decided to build a true ecosystem inside Moodle dedicated to these methodologies. That is how <strong>PlayerGames</strong> was born.',
      subtitle: 'An ecosystem of Moodle plugins built around one goal: making gamification and student engagement a first-class experience — flexible for teachers, meaningful for students.',
      viewGithub: 'View on GitHub →',
      labelPublished: '✅ Published plugins',
      labelInDev: '🚧 In development & review',
      suggestionsTitle: 'Have an idea?',
      suggestionsText: 'Suggestions for new plugins, pedagogical use cases, or improvements to existing ones are always welcome. If you work with Moodle and have a gamification challenge in mind, feel free to reach out or open an issue on GitHub.',
      suggestionsBtn: 'Share a suggestion →',
      docBtn: 'Documentation',
      statuses: {
        'In development · 75%': 'In development · 75%',
        'In development · 80%': 'In development · 80%',
        'In development · 65%': 'In development · 65%',
        'In development · 28%': 'In development · 28%',
        'In development · 20%': 'In development · 20%',
        'In review': 'In review',
      },
      plugins: {
        'PlayerHUD': {
          description: 'The core gamification block for Moodle. Brings XP, customizable levels, achievements, ranking, missions, activity history, and an integrated AI assistant to your courses. Teachers define the rules — students choose to engage.',
          tags: ['Block', 'Gamification', 'XP', 'Achievements', 'AI', 'Ranking'],
        },
        'PlayerHUD Filter': {
          description: 'A companion text filter that lets you embed live PlayerHUD data — current level, XP, and progress — directly inside Moodle activity content using simple shortcodes. No need to leave the page.',
          tags: ['Filter', 'Gamification', 'Dynamic Content', 'Shortcodes'],
        },
        'PlayerHUD Availability': {
          description: "An availability condition that restricts access to activities, resources, or course sections based on a student's PlayerHUD progress — unlock content only when a student reaches a specific level or XP threshold.",
          tags: ['Availability', 'Gamification', 'XP Gating', 'Conditional Access'],
        },
        'PlayerGroup': {
          description: 'Lets students autonomously form their own groups directly from the activity page — no teacher intervention needed. Replaces manual group assignment with a self-service experience that works with any course format.',
          tags: ['Activity', 'Groups', 'Collaboration', 'Gamification'],
        },
        'PlayerGames': {
          description: 'The central hub of the ecosystem. Manages cartridges, quizzes, leaderboards and a full suite of gamified mini-games — providing a unified engine that all Player* activities connect to.',
          tags: ['Local', 'Hub', 'Gamification', 'AI', 'Quizzes'],
        },
        'PlayerCross': {
          description: 'A crossword-puzzle activity powered by course content. Clues are generated from the glossary or via AI, and students solve the mystery phrase by filling in the grid.',
          tags: ['Activity', 'Crossword', 'AI', 'Vocabulary'],
        },
        'PlayerLand': {
          description: 'A 2-D side-scroller game (Phaser) where students run through a course-themed level and answer formative questions embedded as in-world blocks.',
          tags: ['Activity', 'Game', 'Phaser', 'Formative'],
        },
        'PlayerPuzzle': {
          description: 'A Match-3 puzzle activity where correct answers clear tiles. Progress, scoring and debrief integrate with the gradebook and the PlayerHUD XP system.',
          tags: ['Activity', 'Match-3', 'Game', 'AI'],
        },
        'PlayerRaid': {
          description: 'A cooperative raid activity where student teams tackle challenge waves together. XP rewards and team rankings feed directly into PlayerHUD.',
          tags: ['Activity', 'Cooperative', 'Teams', 'Gamification'],
        },
        'PlayerWords': {
          description: 'A word-game activity (Wordle-style) that challenges students to guess vocabulary terms from the course. Supports AI-generated clues and connects to PlayerHUD XP.',
          tags: ['Activity', 'Vocabulary', 'Word Game', 'AI'],
        },
        'PlayerGames Block': {
          description: 'A lightweight block that mirrors the PlayerHUD profile panel on the dashboard and homepage — showing XP, level and missions without requiring a full block re-render.',
          tags: ['Block', 'Dashboard', 'Gamification'],
        },
      },
    },
    pt: {
      origin: 'Sempre fui apaixonado por games — e por anos explorei formas de levá-los para a educação através do Moodle. Após trabalhar extensivamente com gamificação e aprendizagem baseada em games, decidi construir um verdadeiro ecossistema dentro do Moodle dedicado a estas metodologias. Foi assim que o <strong>PlayerGames</strong> nasceu.',
      subtitle: 'Um ecossistema de plugins para Moodle construído em torno de um objetivo: tornar a gamificação e o engajamento dos alunos uma experiência de primeira classe — flexível para professores, significativa para alunos.',
      viewGithub: 'Ver no GitHub →',
      labelPublished: '✅ Plugins publicados',
      labelInDev: '🚧 Em desenvolvimento e revisão',
      suggestionsTitle: 'Tem uma sugestão?',
      suggestionsText: 'Sugestões para novos plugins, casos de uso pedagógicos ou melhorias nos existentes são sempre bem-vindos. Se você trabalha com Moodle e tem um desafio de gamificação em mente, sinta-se à vontade para entrar em contato ou abrir uma issue no GitHub.',
      suggestionsBtn: 'Compartilhe uma sugestão →',
      docBtn: 'Documentação',
      statuses: {
        'In development · 75%': 'Em desenvolvimento · 75%',
        'In development · 80%': 'Em desenvolvimento · 80%',
        'In development · 65%': 'Em desenvolvimento · 65%',
        'In development · 28%': 'Em desenvolvimento · 28%',
        'In development · 20%': 'Em desenvolvimento · 20%',
        'In review': 'Em revisão',
      },
      plugins: {
        'PlayerHUD': {
          description: 'Bloco de gamificação completo para Moodle. Oferece XP, níveis personalizáveis, sistema de conquistas, ranking, missões, histórico de atividades e um assistente de IA integrado para sugestões pedagógicas.',
          tags: ['Bloco', 'Gamificação', 'XP', 'Conquistas', 'IA', 'Ranking'],
        },
        'PlayerHUD Filter': {
          description: 'Filtro de texto que permite exibir dados do PlayerHUD diretamente no conteúdo de atividades e recursos — nível atual do aluno, XP acumulado e progresso — sem precisar sair da página.',
          tags: ['Filtro', 'Gamificação', 'Conteúdo Dinâmico'],
        },
        'PlayerHUD Availability': {
          description: 'Condição de disponibilidade que permite restringir o acesso a atividades com base nos dados do PlayerHUD — libere conteúdo somente quando o aluno atingir determinado nível ou quantidade de XP.',
          tags: ['Disponibilidade', 'Gamificação', 'Restrição por XP'],
        },
        'PlayerGroup': {
          description: 'Plugin de atividade para grupos gamificados no Moodle. Crie equipes com XP coletivo, missões colaborativas e ranking entre times. Integra com o PlayerHUD para uma experiência gamificada completa.',
          tags: ['Atividade', 'Grupos', 'Colaboração', 'Gamificação'],
        },
        'PlayerGames': {
          description: 'Hub central do ecossistema. Gerencia cartuchos, quizzes, rankings e uma suíte completa de mini-games gamificados — fornecendo o motor unificado ao qual todas as atividades Player* se conectam.',
          tags: ['Local', 'Hub', 'Gamificação', 'IA', 'Quizzes'],
        },
        'PlayerCross': {
          description: 'Atividade de palavras cruzadas impulsionada pelo conteúdo do curso. As pistas são geradas a partir do glossário ou via IA, e os alunos resolvem a frase misteriosamente preenchendo a grade.',
          tags: ['Atividade', 'Palavras Cruzadas', 'IA', 'Vocabulário'],
        },
        'PlayerLand': {
          description: 'Jogo de plataforma 2D (Phaser) onde os alunos percorrem um nível temático do curso e respondem perguntas formativas embutidas como blocos interativos no mundo do jogo.',
          tags: ['Atividade', 'Jogo', 'Phaser', 'Formativo'],
        },
        'PlayerPuzzle': {
          description: 'Atividade Match-3 onde respostas corretas eliminam peças. O progresso, pontuação e debriefing integram-se ao livro de notas e ao sistema de XP do PlayerHUD.',
          tags: ['Atividade', 'Match-3', 'Jogo', 'IA'],
        },
        'PlayerRaid': {
          description: 'Atividade colaborativa de raid onde equipes de alunos enfrentam ondas de desafios juntos. As recompensas de XP e rankings alimentam diretamente o PlayerHUD.',
          tags: ['Atividade', 'Cooperativo', 'Equipes', 'Gamificação'],
        },
        'PlayerWords': {
          description: 'Atividade de jogo de palavras (estilo Wordle) que desafia os alunos a adivinhar termos do vocabulário do curso. Suporta pistas geradas por IA e conecta-se ao XP do PlayerHUD.',
          tags: ['Atividade', 'Vocabulário', 'Jogo de Palavras', 'IA'],
        },
        'PlayerGames Block': {
          description: 'Bloco leve que espelha o painel de perfil do PlayerHUD na página inicial e no dashboard — exibindo XP, nível e missões sem necessitar de uma rerenderização completa do bloco.',
          tags: ['Bloco', 'Dashboard', 'Gamificação'],
        },
      },
    },
  };

  function applyLang(lang) {
    const t = T[lang];
    if (!t) return;

    // Static text elements
    document.querySelectorAll('[data-i18n]').forEach(el => {
      const key = el.getAttribute('data-i18n');
      if (t[key] !== undefined) el.innerHTML = t[key];
    });

    // Status badges
    document.querySelectorAll('[data-i18n-status]').forEach(el => {
      const key = el.getAttribute('data-i18n-status');
      el.textContent = t.statuses[key] || key;
    });

    // Plugin card descriptions and tags
    document.querySelectorAll('[data-plugin-key]').forEach(wrapper => {
      const name = wrapper.getAttribute('data-plugin-key');
      const data = t.plugins[name];
      if (!data) return;

      const desc = wrapper.querySelector('.plugin-description');
      if (desc) desc.textContent = data.description;

      const tagsContainer = wrapper.querySelector('.plugin-tags');
      if (tagsContainer) {
        tagsContainer.innerHTML = data.tags
          .map(tag => `<span class="badge badge--muted">${tag}</span>`)
          .join('');
      }
    });

    // Update button states
    document.querySelectorAll('.pg-lang-btn').forEach(btn => {
      btn.classList.toggle('active', btn.getAttribute('data-lang') === lang);
    });

    // Last-updated date
    const updEl = document.querySelector('.pg-last-updated');
    if (updEl) {
      updEl.textContent = lang === 'pt'
        ? updEl.getAttribute('data-updated-pt')
        : updEl.getAttribute('data-updated-en');
    }

    localStorage.setItem('pg-lang', lang);
  }

  // Init
  const saved = localStorage.getItem('pg-lang') || 'en';
  applyLang(saved);

  document.querySelectorAll('.pg-lang-btn').forEach(btn => {
    btn.addEventListener('click', () => applyLang(btn.getAttribute('data-lang')));
  });
})();
</script>
