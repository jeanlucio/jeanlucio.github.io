---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

const allItems = await getCollection('biblioteca');
const sorted = allItems.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const ownItems = sorted.filter(item => item.data.origin === 'own');
const curatedItems = sorted.filter(item => item.data.origin === 'curated');
const defaultTab = ownItems.length > 0 ? 'own' : 'curated';

const TYPE_OPTIONS = [
  { value: 'all', label: 'Todos' },
  { value: 'article', label: 'Artigos' },
  { value: 'book', label: 'Livros' },
  { value: 'course', label: 'Cursos' },
  { value: 'video', label: 'Vídeos' },
  { value: 'tool', label: 'Ferramentas' },
  { value: 'game', label: 'Jogos' },
];

const TYPE_LABELS: Record<string, string> = {
  article: 'Artigo',
  book: 'Livro',
  course: 'Curso',
  video: 'Vídeo',
  tool: 'Ferramenta',
  game: 'Jogo',
};

const TYPE_CLASS: Record<string, string> = {
  article: 'type--article',
  book: 'type--book',
  course: 'type--course',
  video: 'type--video',
  tool: 'type--tool',
  game: 'type--game',
};
---

<BaseLayout
  title="Webteca — Jean Lúcio"
  description="Referências, leituras e ferramentas sobre educação, tecnologia e gamificação — produções próprias e curadoria."
>
  <section class="lib-page">
    <div class="container">
      <header class="page-header">
        <h1 class="page-title">Webteca</h1>
        <p class="page-subtitle">
          Referências, leituras e ferramentas sobre educação, tecnologia e gamificação
          — produções próprias e curadoria.
        </p>
      </header>

      <div class="lib-controls" data-default-tab={defaultTab}>
        <div role="tablist" class="lib-tabs" aria-label="Origem dos itens">
          <button
            role="tab"
            class={`tab-btn${defaultTab === 'own' ? ' tab-btn--active' : ''}`}
            id="tab-own"
            aria-selected={defaultTab === 'own' ? 'true' : 'false'}
            aria-controls="panel-own"
          >
            Meus <span class="tab-count">{ownItems.length}</span>
          </button>
          <button
            role="tab"
            class={`tab-btn${defaultTab === 'curated' ? ' tab-btn--active' : ''}`}
            id="tab-curated"
            aria-selected={defaultTab === 'curated' ? 'true' : 'false'}
            aria-controls="panel-curated"
          >
            Curadoria <span class="tab-count">{curatedItems.length}</span>
          </button>
        </div>

        <div class="search-wrap">
          <svg class="search-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <circle cx="11" cy="11" r="8" />
            <line x1="21" y1="21" x2="16.65" y2="16.65" />
          </svg>
          <input
            type="search"
            id="lib-search"
            class="search-input"
            placeholder="Buscar título, autor, tags…"
            aria-label="Buscar na Webteca"
            autocomplete="off"
          />
        </div>

        <div class="type-filters" role="group" aria-label="Filtrar por tipo">
          {TYPE_OPTIONS.map(opt => (
            <button
              class={`filter-btn${opt.value === 'all' ? ' filter-btn--active' : ''}`}
              data-filter={opt.value}
            >
              {opt.label}
            </button>
          ))}
        </div>
      </div>

      <!-- Painel: Meus -->
      <div role="tabpanel" id="panel-own" aria-labelledby="tab-own" hidden={defaultTab !== 'own'}>
        {ownItems.length === 0 ? (
          <div class="empty-state"><p>Nenhum item ainda. Em breve!</p></div>
        ) : (
          <div class="lib-table-wrap">
            <table class="lib-table">
              <thead>
                <tr>
                  <th scope="col" class="col-type">Tipo</th>
                  <th scope="col" class="col-main">Título / Descrição</th>
                  <th scope="col" class="col-author">Autor</th>
                </tr>
              </thead>
              <tbody>
                {ownItems.map(item => (
                  <tr data-type={item.data.type}>
                    <td class="col-type">
                      <span class={`type-badge ${TYPE_CLASS[item.data.type] ?? ''}`}>
                        {TYPE_LABELS[item.data.type] ?? item.data.type}
                      </span>
                    </td>
                    <td class="col-main">
                      <a
                        href={item.data.url}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="item-title"
                        aria-label={`${item.data.title} (abre em nova aba)`}
                      >
                        {item.data.title}
                        <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
                          <path d="M18 13v6a2 2 0 01-2 2H5a2 2 0 01-2-2V8a2 2 0 012-2h6" />
                          <polyline points="15 3 21 3 21 9" />
                          <line x1="10" y1="14" x2="21" y2="3" />
                        </svg>
                      </a>
                      <p class="item-desc">{item.data.description}</p>
                      {item.data.tags.length > 0 && (
                        <ul class="item-tags" aria-label="Tags">
                          {item.data.tags.map(tag => (
                            <li class="item-tag">#{tag}</li>
                          ))}
                        </ul>
                      )}
                    </td>
                    <td class="col-author">{item.data.author ?? '—'}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        )}
        <div class="filter-empty" hidden><p>Nenhum resultado encontrado.</p></div>
      </div>

      <!-- Painel: Curadoria -->
      <div role="tabpanel" id="panel-curated" aria-labelledby="tab-curated" hidden={defaultTab !== 'curated'}>
        {curatedItems.length === 0 ? (
          <div class="empty-state"><p>Nenhum item ainda. Em breve!</p></div>
        ) : (
          <div class="lib-table-wrap">
            <table class="lib-table">
              <thead>
                <tr>
                  <th scope="col" class="col-type">Tipo</th>
                  <th scope="col" class="col-main">Título / Descrição</th>
                  <th scope="col" class="col-author">Autor</th>
                </tr>
              </thead>
              <tbody>
                {curatedItems.map(item => (
                  <tr data-type={item.data.type}>
                    <td class="col-type">
                      <span class={`type-badge ${TYPE_CLASS[item.data.type] ?? ''}`}>
                        {TYPE_LABELS[item.data.type] ?? item.data.type}
                      </span>
                    </td>
                    <td class="col-main">
                      <a
                        href={item.data.url}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="item-title"
                        aria-label={`${item.data.title} (abre em nova aba)`}
                      >
                        {item.data.title}
                        <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
                          <path d="M18 13v6a2 2 0 01-2 2H5a2 2 0 01-2-2V8a2 2 0 012-2h6" />
                          <polyline points="15 3 21 3 21 9" />
                          <line x1="10" y1="14" x2="21" y2="3" />
                        </svg>
                      </a>
                      <p class="item-desc">{item.data.description}</p>
                      {item.data.tags.length > 0 && (
                        <ul class="item-tags" aria-label="Tags">
                          {item.data.tags.map(tag => (
                            <li class="item-tag">#{tag}</li>
                          ))}
                        </ul>
                      )}
                    </td>
                    <td class="col-author">{item.data.author ?? '—'}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        )}
        <div class="filter-empty" hidden><p>Nenhum resultado encontrado.</p></div>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  const controls = document.querySelector<HTMLElement>('.lib-controls');
  const defaultTab = controls?.dataset.defaultTab ?? 'own';

  const tabBtns = document.querySelectorAll<HTMLButtonElement>('[role="tab"]');
  const filterBtns = document.querySelectorAll<HTMLButtonElement>('.filter-btn');
  const panels = document.querySelectorAll<HTMLElement>('[role="tabpanel"]');
  const searchInput = document.getElementById('lib-search') as HTMLInputElement | null;

  let activeTab = defaultTab;
  let activeFilter = 'all';
  let activeSearch = '';

  function getRowText(row: HTMLElement): string {
    const title = row.querySelector('.item-title')?.textContent ?? '';
    const desc = row.querySelector('.item-desc')?.textContent ?? '';
    const author = row.querySelector('.col-author')?.textContent ?? '';
    const tags = Array.from(row.querySelectorAll('.item-tag'))
      .map(t => t.textContent ?? '')
      .join(' ');
    return `${title} ${desc} ${author} ${tags}`.toLowerCase();
  }

  function applyFilter(): void {
    const panel = document.getElementById(`panel-${activeTab}`);
    if (!panel) {
      return;
    }

    const query = activeSearch.toLowerCase().trim();
    const rows = panel.querySelectorAll<HTMLElement>('tbody [data-type]');
    let visible = 0;

    rows.forEach(row => {
      const typeMatch = activeFilter === 'all' || row.dataset.type === activeFilter;
      const searchMatch = query === '' || getRowText(row).includes(query);
      const show = typeMatch && searchMatch;
      row.hidden = !show;
      if (show) {
        visible++;
      }
    });

    const filterEmpty = panel.querySelector<HTMLElement>('.filter-empty');
    const tableWrap = panel.querySelector<HTMLElement>('.lib-table-wrap');

    if (filterEmpty) {
      filterEmpty.hidden = visible > 0;
    }
    if (tableWrap) {
      tableWrap.hidden = visible === 0;
    }

    filterBtns.forEach(btn => {
      btn.classList.toggle('filter-btn--active', btn.dataset.filter === activeFilter);
    });
  }

  function switchTab(tabId: string): void {
    activeTab = tabId;
    activeFilter = 'all';

    panels.forEach(panel => {
      panel.hidden = panel.id !== `panel-${tabId}`;
    });

    tabBtns.forEach(btn => {
      const isActive = btn.id === `tab-${tabId}`;
      btn.setAttribute('aria-selected', String(isActive));
      btn.classList.toggle('tab-btn--active', isActive);
    });

    applyFilter();
  }

  tabBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      switchTab(btn.id.replace('tab-', ''));
    });
  });

  filterBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      activeFilter = btn.dataset.filter ?? 'all';
      applyFilter();
    });
  });

  searchInput?.addEventListener('input', () => {
    activeSearch = searchInput.value;
    applyFilter();
  });

  switchTab(defaultTab);
</script>

<style>
  .lib-page {
    padding: 4rem 0 6rem;
  }

  .page-header {
    margin-bottom: 3rem;
  }

  .page-title {
    font-size: clamp(2rem, 5vw, 3rem);
    font-weight: 800;
    margin-bottom: 0.5rem;
  }

  .page-subtitle {
    color: var(--color-text-muted);
    font-size: 1.05rem;
    max-width: 600px;
    margin: 0;
  }

  /* ---- Controls ---- */
  .lib-controls {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    margin-bottom: 2.5rem;
  }

  .lib-tabs {
    display: flex;
    gap: 0.25rem;
    background: var(--color-bg-alt);
    border-radius: var(--radius);
    padding: 0.3rem;
    width: fit-content;
  }

  .tab-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.5rem 1.25rem;
    border-radius: calc(var(--radius) - 2px);
    border: none;
    background: transparent;
    color: var(--color-text-muted);
    font-size: 0.9rem;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .tab-btn--active {
    background: var(--color-bg);
    color: var(--color-text);
    box-shadow: var(--shadow-sm);
  }

  .tab-count {
    background: var(--color-border);
    color: var(--color-text-muted);
    font-size: 0.72rem;
    padding: 0.1rem 0.45rem;
    border-radius: 999px;
    transition: all 0.2s ease;
  }

  .tab-btn--active .tab-count {
    background: var(--color-primary);
    color: #fff;
  }

  .type-filters {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .filter-btn {
    padding: 0.35rem 0.9rem;
    border-radius: 999px;
    border: 1px solid var(--color-border);
    background: transparent;
    color: var(--color-text-muted);
    font-size: 0.825rem;
    font-weight: 500;
    cursor: pointer;
    transition: all 0.15s ease;
  }

  .filter-btn:not(.filter-btn--active):hover {
    border-color: var(--color-primary);
    color: var(--color-primary);
  }

  .filter-btn--active,
  .filter-btn--active:hover {
    background: var(--color-primary);
    border-color: var(--color-primary);
    color: #fff;
  }

  /* ---- Table ---- */
  .lib-table-wrap {
    overflow-x: auto;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
  }

  .lib-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.9rem;
  }

  .lib-table thead {
    background: var(--color-bg-alt);
    border-bottom: 1px solid var(--color-border);
  }

  .lib-table th {
    padding: 0.75rem 1rem;
    text-align: start;
    font-size: 0.775rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-text-muted);
  }

  .lib-table tbody tr {
    border-bottom: 1px solid var(--color-border);
    transition: background 0.15s ease;
  }

  .lib-table tbody tr:last-child {
    border-bottom: none;
  }

  .lib-table tbody tr:hover {
    background: var(--color-bg-alt);
  }

  .lib-table td {
    padding: 1rem;
    vertical-align: top;
  }

  /* ---- Columns ---- */
  .col-type {
    width: 90px;
    white-space: nowrap;
  }

  .col-main {
    min-width: 260px;
  }

  .col-author {
    width: 220px;
    font-size: 0.825rem;
    color: var(--color-text-muted);
    line-height: 1.5;
  }

  @media (max-width: 640px) {
    .col-author {
      display: none;
    }
  }

  /* ---- Type badges ---- */
  .type-badge {
    display: inline-block;
    padding: 0.2rem 0.6rem;
    border-radius: 999px;
    font-size: 0.7rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    white-space: nowrap;
  }

  .type--book    { background: #EDE9FE; color: #5B21B6; }
  .type--course  { background: #D1FAE5; color: #065F46; }
  .type--article { background: #FEF3C7; color: #92400E; }
  .type--video   { background: #FEE2E2; color: #991B1B; }
  .type--tool    { background: #DBEAFE; color: #1E40AF; }
  .type--game    { background: #FCE7F3; color: #9D174D; }

  /* ---- Item content ---- */
  .item-title {
    display: inline-flex;
    align-items: baseline;
    gap: 0.3rem;
    font-weight: 700;
    font-size: 0.95rem;
    color: var(--color-text);
    text-decoration: none;
    line-height: 1.4;
    transition: color 0.15s ease;
  }

  .item-title:hover {
    color: var(--color-primary);
  }

  .item-title svg {
    opacity: 0.4;
    flex-shrink: 0;
  }

  .item-desc {
    margin: 0.35rem 0 0;
    font-size: 0.85rem;
    color: var(--color-text-muted);
    line-height: 1.6;
  }

  .item-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.3rem;
    list-style: none;
    margin: 0.5rem 0 0;
    padding: 0;
  }

  .item-tag {
    font-size: 0.72rem;
    color: var(--color-text-muted);
    background: var(--color-bg-alt);
    border: 1px solid var(--color-border);
    padding: 0.1rem 0.45rem;
    border-radius: 999px;
  }

  /* ---- Search ---- */
  .search-wrap {
    position: relative;
    max-width: 380px;
  }

  .search-icon {
    position: absolute;
    inset-inline-start: 0.75rem;
    top: 50%;
    transform: translateY(-50%);
    color: var(--color-text-muted);
    pointer-events: none;
  }

  .search-input {
    width: 100%;
    padding: 0.5rem 0.875rem 0.5rem 2.25rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    background: var(--color-bg);
    color: var(--color-text);
    font-size: 0.875rem;
    outline: none;
    transition: border-color 0.15s ease, box-shadow 0.15s ease;
  }

  .search-input::placeholder {
    color: var(--color-text-muted);
  }

  .search-input:focus {
    border-color: var(--color-primary);
    box-shadow: 0 0 0 3px rgba(99, 102, 241, 0.15);
  }

  /* ---- Empty states ---- */
  .empty-state,
  .filter-empty {
    text-align: center;
    padding: 4rem 1rem;
    color: var(--color-text-muted);
    font-size: 1rem;
  }
</style>
