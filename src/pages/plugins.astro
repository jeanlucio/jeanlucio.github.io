---
import BaseLayout from '../layouts/BaseLayout.astro';
import PluginCard from '../components/PluginCard.astro';

const playerGames = [
  {
    name: 'PlayerHUD',
    description: 'Bloco de gamificação completo para Moodle. Oferece XP, níveis personalizáveis, sistema de conquistas, ranking, missões, histórico de atividades e um assistente de IA integrado (Gemini/Groq) para sugestões pedagógicas.',
    version: '1.4.0',
    tags: ['Bloco', 'Gamificação', 'XP', 'Conquistas', 'IA', 'Ranking'],
    githubUrl: 'https://github.com/jeanlucio/moodle-block_playerhud',
    moodleUrl: 'https://moodle.org/plugins/block_playerhud',
    color: 'indigo' as const,
    icon: '🎮',
  },
  {
    name: 'PlayerHUD Filter',
    description: 'Filtro de texto que permite exibir dados do PlayerHUD diretamente no conteúdo de atividades e recursos — nível atual do aluno, XP acumulado e progresso — sem precisar sair da página.',
    version: '1.0.0',
    tags: ['Filtro', 'Gamificação', 'Conteúdo Dinâmico'],
    githubUrl: 'https://github.com/jeanlucio/moodle-filter_playerhud',
    moodleUrl: 'https://moodle.org/plugins/filter_playerhud',
    color: 'indigo' as const,
    icon: '🔤',
  },
  {
    name: 'PlayerHUD Availability',
    description: 'Condição de disponibilidade que permite restringir o acesso a atividades com base nos dados do PlayerHUD — libere conteúdo somente quando o aluno atingir determinado nível ou quantidade de XP.',
    version: '1.0.0',
    tags: ['Disponibilidade', 'Gamificação', 'Restrição por XP'],
    githubUrl: 'https://github.com/jeanlucio/moodle-availability_playerhud',
    moodleUrl: 'https://moodle.org/plugins/availability_playerhud',
    color: 'purple' as const,
    icon: '🔓',
  },
  {
    name: 'PlayerGroup',
    description: 'Plugin de atividade para grupos gamificados no Moodle. Crie equipes com XP coletivo, missões colaborativas e ranking entre times. Integra com o PlayerHUD para uma experiência gamificada completa.',
    version: '1.1.0',
    tags: ['Atividade', 'Grupos', 'Colaboração', 'Gamificação'],
    githubUrl: 'https://github.com/jeanlucio/moodle-mod_playergroup',
    moodleUrl: 'https://moodle.org/plugins/mod_playergroup',
    color: 'purple' as const,
    icon: '👥',
  },
];

const teacherTools = [
  {
    name: 'Teacher Checklist',
    description: 'Bloco que ajuda professores a garantir a qualidade do curso antes de os alunos chegarem. Combina detecção automática de problemas de configuração (visibilidade, prazos, atividades sem descrição) com uma lista de tarefas manual totalmente personalizável.',
    version: '1.2.1',
    tags: ['Bloco', 'Qualidade', 'Checklist', 'Coordenação'],
    githubUrl: 'https://github.com/jeanlucio/moodle-block_teacher_checklist',
    moodleUrl: 'https://moodle.org/plugins/block_teacher_checklist',
    color: 'emerald' as const,
    icon: '✅',
  },
  {
    name: 'Resource Stats',
    description: 'Plugin local que exibe badges de acesso nos módulos do curso — total de visualizações e alunos únicos — visível só para professores, sem depender de ferramentas externas de analytics.',
    version: '1.0.2',
    tags: ['Local', 'Estatísticas', 'Engajamento', 'LGPD'],
    githubUrl: 'https://github.com/jeanlucio/moodle-local_resourcestats',
    moodleUrl: 'https://moodle.org/plugins/local_resourcestats',
    color: 'amber' as const,
    icon: '📊',
  },
];
---

<BaseLayout
  title="Plugins — Jean Lúcio"
  description="6 plugins open source para Moodle: ecossistema PlayerGames (gamificação) e ferramentas para professores."
>
  <section class="plugins-page">
    <div class="container">
      <header class="page-header">
        <h1 class="page-title">Plugins</h1>
        <p class="page-subtitle">
          Ferramentas open source que desenvolvo para o Moodle.
          Todas licenciadas sob <strong>GPL v3+</strong>.
        </p>
      </header>

      <!-- Ecossistema PlayerGames -->
      <section class="plugin-group">
        <header class="group-header">
          <div class="group-label">
            <span class="group-icon" aria-hidden="true">🎮</span>
            <h2 class="group-title">Ecossistema PlayerGames</h2>
          </div>
          <p class="group-description">
            Conjunto de plugins complementares que trazem gamificação de ponta a ponta para o Moodle.
            Cada plugin funciona de forma independente e em conjunto.
          </p>
        </header>

        <div class="plugins-grid">
          {playerGames.map(plugin => (
            <PluginCard {...plugin} />
          ))}
        </div>
      </section>

      <!-- Ferramentas para Professores -->
      <section class="plugin-group">
        <header class="group-header">
          <div class="group-label">
            <span class="group-icon" aria-hidden="true">🧑‍🏫</span>
            <h2 class="group-title">Ferramentas para Professores</h2>
          </div>
          <p class="group-description">
            Plugins independentes focados em qualidade de curso e análise de engajamento.
          </p>
        </header>

        <div class="plugins-grid">
          {teacherTools.map(plugin => (
            <PluginCard {...plugin} />
          ))}
        </div>
      </section>

      <aside class="footer-note">
        <a
          href="https://github.com/jeanlucio"
          class="btn btn--outline"
          target="_blank"
          rel="noopener noreferrer"
        >
          Ver todos no GitHub →
        </a>
      </aside>
    </div>
  </section>
</BaseLayout>

<style>
  .plugins-page {
    padding: 4rem 0 6rem;
  }

  .page-header {
    margin-bottom: 3.5rem;
    max-width: 640px;
  }

  .page-title {
    font-size: clamp(2rem, 5vw, 3rem);
    font-weight: 800;
    margin-bottom: 0.5rem;
  }

  .page-subtitle {
    color: var(--color-text-muted);
    font-size: 1.1rem;
    line-height: 1.6;
  }

  .plugin-group {
    margin-bottom: 4rem;
  }

  .group-header {
    margin-bottom: 1.75rem;
    padding-bottom: 1.25rem;
    border-bottom: 2px solid var(--color-border);
  }

  .group-label {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    margin-bottom: 0.5rem;
  }

  .group-icon {
    font-size: 1.4rem;
  }

  .group-title {
    font-size: 1.3rem;
    font-weight: 700;
  }

  .group-description {
    color: var(--color-text-muted);
    font-size: 0.95rem;
    line-height: 1.6;
    margin: 0;
    max-width: 640px;
  }

  .plugins-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(290px, 1fr));
    gap: 1.25rem;
  }

  .footer-note {
    margin-top: 1rem;
    text-align: center;
  }
</style>
