---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PluginCard from '../../components/PluginCard.astro';
import { playerGames } from '../../data/plugins';

// English descriptions and tags — version/updatedDate come from plugins.ts (kept in sync by update-versions.mjs)
const enOverrides: Record<string, { description: string; tags: string[]; docsUrl?: string }> = {
  'PlayerHUD': {
    description: 'The core gamification block for Moodle. Brings XP, customizable levels, achievements, ranking, missions, activity history, and an integrated AI assistant to your courses. Teachers define the rules — students choose to engage.',
    tags: ['Block', 'Gamification', 'XP', 'Achievements', 'AI', 'Ranking'],
    docsUrl: 'https://jeanlucio.github.io/moodle-block_playerhud/',
  },
  'PlayerHUD Filter': {
    description: 'A companion text filter that lets you embed live PlayerHUD data — current level, XP, and progress — directly inside Moodle activity content using simple shortcodes. No need to leave the page.',
    tags: ['Filter', 'Gamification', 'Dynamic Content', 'Shortcodes'],
  },
  'PlayerHUD Availability': {
    description: "An availability condition that restricts access to activities, resources, or course sections based on a student's PlayerHUD progress — unlock content only when a student reaches a specific level or XP threshold.",
    tags: ['Availability', 'Gamification', 'XP Gating', 'Conditional Access'],
  },
  'PlayerGroup': {
    description: 'Lets students autonomously form their own groups directly from the activity page — no teacher intervention needed. Replaces manual group assignment with a self-service experience that works with any course format.',
    tags: ['Activity', 'Groups', 'Collaboration', 'Gamification'],
  },
};

const plugins = playerGames.map(({ reviewUrl: _r, ...p }) => ({
  ...p,
  ...(enOverrides[p.name] ?? {}),
}));

// Plugins in development or review — no Moodle URL yet, version omitted
const inDev = [
  {
    name: 'PlayerGames',
    description: 'The central hub of the ecosystem. Manages cartridges, quizzes, leaderboards and a full suite of gamified mini-games — providing a unified engine that all Player* activities connect to.',
    status: 'In development · 75%',
    tags: ['Local', 'Hub', 'Gamification', 'AI', 'Quizzes'],
    githubUrl: 'https://github.com/jeanlucio/moodle-local_playergames',
    docsUrl: 'https://jeanlucio.github.io/moodle-local_playergames/',
    color: 'indigo' as const,
    icon: '🎮',
  },
  {
    name: 'PlayerCross',
    description: 'A crossword-puzzle activity powered by course content. Clues are generated from the glossary or via AI, and students solve the mystery phrase by filling in the grid.',
    status: 'In development · 80%',
    tags: ['Activity', 'Crossword', 'AI', 'Vocabulary'],
    githubUrl: 'https://github.com/jeanlucio/moodle-mod_playercross',
    color: 'purple' as const,
    icon: '🔤',
  },
  {
    name: 'PlayerLand',
    description: 'A 2-D side-scroller game (Phaser) where students run through a course-themed level and answer formative questions embedded as in-world blocks.',
    status: 'In development · 65%',
    tags: ['Activity', 'Game', 'Phaser', 'Formative'],
    githubUrl: 'https://github.com/jeanlucio/moodle-mod_playerland',
    color: 'purple' as const,
    icon: '🦊',
  },
  {
    name: 'PlayerPuzzle',
    description: 'A Match-3 puzzle activity where correct answers clear tiles. Progress, scoring and debrief integrate with the gradebook and the PlayerHUD XP system.',
    status: 'In development · 28%',
    tags: ['Activity', 'Match-3', 'Game', 'AI'],
    githubUrl: 'https://github.com/jeanlucio/moodle-mod_playerpuzzle',
    color: 'indigo' as const,
    icon: '🧩',
  },
  {
    name: 'PlayerRaid',
    description: 'A cooperative raid activity where student teams tackle challenge waves together. XP rewards and team rankings feed directly into PlayerHUD.',
    status: 'In development · 20%',
    tags: ['Activity', 'Cooperative', 'Teams', 'Gamification'],
    githubUrl: 'https://github.com/jeanlucio/moodle-mod_playerraid',
    color: 'purple' as const,
    icon: '⚔️',
  },
  {
    name: 'PlayerWords',
    description: 'A word-game activity (Wordle-style) that challenges students to guess vocabulary terms from the course. Supports AI-generated clues and connects to PlayerHUD XP.',
    status: 'In review',
    tags: ['Activity', 'Vocabulary', 'Word Game', 'AI'],
    githubUrl: 'https://github.com/jeanlucio/moodle-mod_playerwords',
    docsUrl: 'https://jeanlucio.github.io/moodle-mod_playerwords/',
    color: 'indigo' as const,
    icon: '🔠',
  },
  {
    name: 'PlayerGames Block',
    description: 'A lightweight block that mirrors the PlayerHUD profile panel on the dashboard and homepage — showing XP, level and missions without requiring a full block re-render.',
    status: 'In review',
    tags: ['Block', 'Dashboard', 'Gamification'],
    githubUrl: 'https://github.com/jeanlucio/moodle-block_playergames',
    color: 'indigo' as const,
    icon: '📊',
  },
];
---

<BaseLayout
  title="PlayerGames — Gamification Ecosystem for Moodle"
  description="PlayerGames is an open source ecosystem of Moodle plugins built around gamification and student engagement. Developed by Jean Lúcio."
>
  <section class="pg-page">
    <div class="container">

      <!-- Hero -->
      <header class="pg-hero">
        <div class="pg-hero-badge">🕹️ Open Source · GPL v3+</div>
        <h1 class="pg-hero-title">PlayerGames</h1>
        <p class="pg-hero-origin">
          I have always been passionate about games — and for years I have been exploring ways to bring
          them into education through Moodle. After working extensively with gamification and
          game-based learning, I decided to build a true ecosystem inside Moodle dedicated to these
          methodologies. That is how <strong>PlayerGames</strong> was born.
        </p>
        <p class="pg-hero-subtitle">
          An ecosystem of Moodle plugins built around one goal: making gamification and student engagement
          a first-class experience — flexible for teachers, meaningful for students.
        </p>
        <a
          href="https://github.com/jeanlucio"
          class="btn btn--outline"
          target="_blank"
          rel="noopener noreferrer"
        >
          View on GitHub →
        </a>
      </header>

      <!-- Published Plugins -->
      <div class="pg-section-label">
        <span class="pg-section-tag">✅ Published plugins</span>
      </div>

      <div class="pg-grid">
        {plugins.map(plugin => (
          <PluginCard {...plugin} />
        ))}
      </div>

      <!-- In Development & Review -->
      <div class="pg-section-label pg-section-label--dev">
        <span class="pg-section-tag pg-section-tag--dev">🚧 In development &amp; review</span>
      </div>

      <div class="pg-grid">
        {inDev.map(plugin => (
          <div class="pg-dev-card-wrapper">
            <span class="pg-dev-status">{plugin.status}</span>
            <PluginCard {...plugin} />
          </div>
        ))}
      </div>

      <!-- Suggestions -->
      <div class="pg-suggestions">
        <h2 class="pg-suggestions-title">Have an idea?</h2>
        <p class="pg-suggestions-text">
          Suggestions for new plugins, pedagogical use cases, or improvements to existing ones
          are always welcome. If you work with Moodle and have a gamification challenge in mind,
          feel free to reach out or open an issue on GitHub.
        </p>
        <a
          href="https://github.com/jeanlucio"
          class="btn btn--primary"
          target="_blank"
          rel="noopener noreferrer"
        >
          Share a suggestion →
        </a>
      </div>

    </div>
  </section>
</BaseLayout>

<style>
  .pg-page {
    padding: 4rem 0 6rem;
  }

  /* Hero */
  .pg-hero {
    text-align: center;
    max-width: 680px;
    margin: 0 auto 4rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.25rem;
  }

  .pg-hero-badge {
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-text-muted);
    background: var(--color-bg-alt);
    border: 1px solid var(--color-border);
    padding: 0.3rem 0.9rem;
    border-radius: 999px;
  }

  .pg-hero-title {
    font-size: clamp(2.5rem, 6vw, 3.75rem);
    font-weight: 800;
    margin: 0;
    line-height: 1.1;
  }

  .pg-hero-subtitle {
    font-size: 1.15rem;
    color: var(--color-text-muted);
    line-height: 1.7;
    margin: 0;
  }

  .pg-hero-origin {
    font-size: 1.05rem;
    color: var(--color-text-muted);
    line-height: 1.75;
    margin: 0;
    font-style: italic;
  }

  /* Section label */
  .pg-section-label {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 2rem;
  }

  .pg-section-label::after {
    content: '';
    flex: 1;
    height: 1px;
    background: var(--color-border);
  }

  .pg-section-tag {
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-text-muted);
    background: var(--color-bg-alt);
    padding: 0.3rem 0.85rem;
    border-radius: 999px;
    border: 1px solid var(--color-border);
    white-space: nowrap;
  }

  /* Grid */
  .pg-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(290px, 1fr));
    gap: 1.25rem;
    margin-bottom: 4rem;
  }

  /* In development & review section */
  .pg-section-label--dev {
    margin-top: 0;
  }

  .pg-section-tag--dev {
    color: #B45309;
    background: rgba(245, 158, 11, 0.08);
    border-color: rgba(245, 158, 11, 0.3);
  }

  /* Dev card wrapper — positions the status badge on top of the PluginCard */
  .pg-dev-card-wrapper {
    position: relative;
    display: flex;
    flex-direction: column;
  }

  .pg-dev-status {
    display: inline-block;
    align-self: flex-end;
    margin-bottom: 0.4rem;
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    padding: 0.2rem 0.6rem;
    border-radius: 999px;
    background: rgba(245, 158, 11, 0.12);
    color: #B45309;
    border: 1px solid rgba(245, 158, 11, 0.3);
    white-space: nowrap;
  }

  /* Suggestions */
  .pg-suggestions {
    text-align: center;
    max-width: 560px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
  }

  .pg-suggestions-title {
    font-size: 1.5rem;
    font-weight: 700;
    margin: 0;
  }

  .pg-suggestions-text {
    color: var(--color-text-muted);
    font-size: 0.975rem;
    line-height: 1.7;
    margin: 0;
  }
</style>
