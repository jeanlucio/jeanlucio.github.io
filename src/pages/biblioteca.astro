---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import LibraryCard from '../components/LibraryCard.astro';

const allItems = await getCollection('biblioteca');
const sorted = allItems.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const ownItems = sorted.filter(item => item.data.origin === 'own');
const curatedItems = sorted.filter(item => item.data.origin === 'curated');
const defaultTab = ownItems.length > 0 ? 'own' : 'curated';

const TYPE_OPTIONS = [
  { value: 'all', label: 'Todos' },
  { value: 'article', label: 'Artigos' },
  { value: 'book', label: 'Livros' },
  { value: 'course', label: 'Cursos' },
  { value: 'video', label: 'Vídeos' },
  { value: 'tool', label: 'Ferramentas' },
  { value: 'game', label: 'Jogos' },
];
---

<BaseLayout
  title="Biblioteca — Jean Lúcio"
  description="Referências, leituras e ferramentas sobre educação, tecnologia e gamificação — produções próprias e curadoria."
>
  <section class="lib-page">
    <div class="container">
      <header class="page-header">
        <h1 class="page-title">Biblioteca</h1>
        <p class="page-subtitle">
          Referências, leituras e ferramentas sobre educação, tecnologia e gamificação
          — produções próprias e curadoria.
        </p>
      </header>

      <div class="lib-controls" data-default-tab={defaultTab}>
        <div role="tablist" class="lib-tabs" aria-label="Origem dos itens">
          <button
            role="tab"
            class={`tab-btn${defaultTab === 'own' ? ' tab-btn--active' : ''}`}
            id="tab-own"
            aria-selected={defaultTab === 'own' ? 'true' : 'false'}
            aria-controls="panel-own"
          >
            Meus <span class="tab-count">{ownItems.length}</span>
          </button>
          <button
            role="tab"
            class={`tab-btn${defaultTab === 'curated' ? ' tab-btn--active' : ''}`}
            id="tab-curated"
            aria-selected={defaultTab === 'curated' ? 'true' : 'false'}
            aria-controls="panel-curated"
          >
            Curadoria <span class="tab-count">{curatedItems.length}</span>
          </button>
        </div>

        <div class="type-filters" role="group" aria-label="Filtrar por tipo">
          {TYPE_OPTIONS.map(opt => (
            <button
              class={`filter-btn${opt.value === 'all' ? ' filter-btn--active' : ''}`}
              data-filter={opt.value}
            >
              {opt.label}
            </button>
          ))}
        </div>
      </div>

      <div
        role="tabpanel"
        id="panel-own"
        aria-labelledby="tab-own"
        hidden={defaultTab !== 'own'}
      >
        {ownItems.length === 0 ? (
          <div class="empty-state">
            <p>Nenhum item ainda. Em breve!</p>
          </div>
        ) : (
          <div class="lib-grid">
            {ownItems.map(item => (
              <div data-type={item.data.type}>
                <LibraryCard item={item} />
              </div>
            ))}
          </div>
        )}
        <div class="filter-empty" hidden>
          <p>Nenhum item para este filtro.</p>
        </div>
      </div>

      <div
        role="tabpanel"
        id="panel-curated"
        aria-labelledby="tab-curated"
        hidden={defaultTab !== 'curated'}
      >
        {curatedItems.length === 0 ? (
          <div class="empty-state">
            <p>Nenhum item ainda. Em breve!</p>
          </div>
        ) : (
          <div class="lib-grid">
            {curatedItems.map(item => (
              <div data-type={item.data.type}>
                <LibraryCard item={item} />
              </div>
            ))}
          </div>
        )}
        <div class="filter-empty" hidden>
          <p>Nenhum item para este filtro.</p>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  const controls = document.querySelector<HTMLElement>('.lib-controls');
  const defaultTab = controls?.dataset.defaultTab ?? 'own';

  const tabBtns = document.querySelectorAll<HTMLButtonElement>('[role="tab"]');
  const filterBtns = document.querySelectorAll<HTMLButtonElement>('.filter-btn');
  const panels = document.querySelectorAll<HTMLElement>('[role="tabpanel"]');

  let activeTab = defaultTab;
  let activeFilter = 'all';

  function applyFilter(): void {
    const panel = document.getElementById(`panel-${activeTab}`);
    if (!panel) {
      return;
    }

    const cards = panel.querySelectorAll<HTMLElement>('[data-type]');
    let visible = 0;

    cards.forEach(card => {
      const show = activeFilter === 'all' || card.dataset.type === activeFilter;
      card.hidden = !show;
      if (show) {
        visible++;
      }
    });

    const filterEmpty = panel.querySelector<HTMLElement>('.filter-empty');
    const libGrid = panel.querySelector<HTMLElement>('.lib-grid');

    if (filterEmpty) {
      filterEmpty.hidden = visible > 0 || activeFilter === 'all';
    }
    if (libGrid) {
      libGrid.hidden = visible === 0 && activeFilter !== 'all';
    }

    filterBtns.forEach(btn => {
      btn.classList.toggle('filter-btn--active', btn.dataset.filter === activeFilter);
    });
  }

  function switchTab(tabId: string): void {
    activeTab = tabId;
    activeFilter = 'all';

    panels.forEach(panel => {
      panel.hidden = panel.id !== `panel-${tabId}`;
    });

    tabBtns.forEach(btn => {
      const isActive = btn.id === `tab-${tabId}`;
      btn.setAttribute('aria-selected', String(isActive));
      btn.classList.toggle('tab-btn--active', isActive);
    });

    applyFilter();
  }

  tabBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      switchTab(btn.id.replace('tab-', ''));
    });
  });

  filterBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      activeFilter = btn.dataset.filter ?? 'all';
      applyFilter();
    });
  });

  switchTab(defaultTab);
</script>

<style>
  .lib-page {
    padding: 4rem 0 6rem;
  }

  .page-header {
    margin-bottom: 3rem;
  }

  .page-title {
    font-size: clamp(2rem, 5vw, 3rem);
    font-weight: 800;
    margin-bottom: 0.5rem;
  }

  .page-subtitle {
    color: var(--color-text-muted);
    font-size: 1.05rem;
    max-width: 600px;
    margin: 0;
  }

  .lib-controls {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    margin-bottom: 2.5rem;
  }

  .lib-tabs {
    display: flex;
    gap: 0.25rem;
    background: var(--color-bg-alt);
    border-radius: var(--radius);
    padding: 0.3rem;
    width: fit-content;
  }

  .tab-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.5rem 1.25rem;
    border-radius: calc(var(--radius) - 2px);
    border: none;
    background: transparent;
    color: var(--color-text-muted);
    font-size: 0.9rem;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .tab-btn--active {
    background: var(--color-bg);
    color: var(--color-text);
    box-shadow: var(--shadow-sm);
  }

  .tab-count {
    background: var(--color-border);
    color: var(--color-text-muted);
    font-size: 0.72rem;
    padding: 0.1rem 0.45rem;
    border-radius: 999px;
    transition: all 0.2s ease;
  }

  .tab-btn--active .tab-count {
    background: var(--color-primary);
    color: #fff;
  }

  .type-filters {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .filter-btn {
    padding: 0.35rem 0.9rem;
    border-radius: 999px;
    border: 1px solid var(--color-border);
    background: transparent;
    color: var(--color-text-muted);
    font-size: 0.825rem;
    font-weight: 500;
    cursor: pointer;
    transition: all 0.15s ease;
  }

  .filter-btn:not(.filter-btn--active):hover {
    border-color: var(--color-primary);
    color: var(--color-primary);
  }

  .filter-btn--active,
  .filter-btn--active:hover {
    background: var(--color-primary);
    border-color: var(--color-primary);
    color: #fff;
  }

  .lib-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: 1.5rem;
  }

  .empty-state,
  .filter-empty {
    text-align: center;
    padding: 4rem 1rem;
    color: var(--color-text-muted);
    font-size: 1rem;
  }
</style>
